@page "/budget-profiles/{ProfileId:guid}/payment-methods"
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using PersonalFinance.Contracts.Profiles
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject BffAuthenticationStateProvider Authentication

<PageTitle>Payment methods</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8 px-4">
    @if (_loading)
    {
        <div role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
            <MudText>Loading payment methods…</MudText>
        </div>
    }
    else if (_unavailable)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Budget profile unavailable</MudText>
        <MudText role="status">This profile isn't available. It may have been removed or you may no longer have access.</MudText>
        <MudButton Href="/budget-profiles" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Back to profiles</MudButton>
    }
    else if (_error)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Payment methods</MudText>
        <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">We couldn't load payment methods. Please try again.</MudAlert>
        <MudButton OnClick="LoadAsync" Variant="Variant.Outlined" Color="Color.Primary">Try again</MudButton>
        <MudButton Href="/budget-profiles" Class="ml-2">Back to profiles</MudButton>
    }
    else if (_methods is not null)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Payment methods</MudText>
        <MudText Typo="Typo.h6" HtmlTag="h2">@_methods.ProfileName</MudText>
        <MudText>Your access: @RoleLabel(_methods.Role)</MudText>
        <MudPaper Outlined="true" Class="pa-4 mt-5">
            @if (_methods.Methods.Count == 0)
            {
                <MudText role="status">No payment methods are available.</MudText>
            }
            else
            {
                <ul aria-label="Profile payment methods">
                    @foreach (var method in _methods.Methods)
                    {
                        <li @key="method.Id">@PaymentMethodLabel(method.Kind)</li>
                    }
                </ul>
            }
        </MudPaper>
        <MudButton Href="@($"/budget-profiles/{ProfileId}")" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-5">Back to profile</MudButton>
    }
</MudContainer>

@code {
    [Parameter] public Guid ProfileId { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _activeLoad;
    private int _loadGeneration;
    private ProfilePaymentMethodsResponse? _methods;
    private bool _loading;
    private bool _error;
    private bool _unavailable;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var profileId = ProfileId;
        var generation = ++_loadGeneration;
        var requestCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var previousLoad = _activeLoad;
        _activeLoad = requestCancellation;
        previousLoad?.Cancel();
        _loading = true;
        _error = false;
        _unavailable = false;
        _methods = null;
        var cancellationToken = requestCancellation.Token;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, $"api/budget-profiles/{profileId}/payment-methods");
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            using var response = await Http.SendAsync(request, cancellationToken);
            if (generation != _loadGeneration) return;
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Authentication.NotifySignedOut();
                Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/budget-profiles/{profileId}/payment-methods")}", replace: true);
                return;
            }
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _unavailable = true;
                return;
            }
            response.EnsureSuccessStatusCode();
            var methods = await response.Content.ReadFromJsonAsync<ProfilePaymentMethodsResponse>(cancellationToken: cancellationToken)
                ?? throw new JsonException("The payment methods are missing.");
            if (methods.ProfileId != profileId || methods.Methods is null)
                throw new JsonException("The payment methods response is invalid.");
            if (generation == _loadGeneration) _methods = methods;
        }
        catch (OperationCanceledException) when (requestCancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or JsonException)
        {
            if (generation == _loadGeneration) _error = true;
        }
        finally
        {
            if (generation == _loadGeneration) _loading = false;
            if (ReferenceEquals(_activeLoad, requestCancellation)) _activeLoad = null;
            requestCancellation.Dispose();
        }
    }

    private static string RoleLabel(string role) => role switch
    {
        "owner" => "Owner",
        "editor" => "Editor",
        "view_only" => "View only",
        _ => "Unavailable"
    };

    private static string PaymentMethodLabel(string kind) => kind switch
    {
        "cash" => "Cash",
        _ => "Unavailable"
    };

    public void Dispose()
    {
        ++_loadGeneration;
        _methods = null;
        _activeLoad?.Cancel();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
