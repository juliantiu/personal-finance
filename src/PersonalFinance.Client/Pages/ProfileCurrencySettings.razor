@page "/budget-profiles/{ProfileId:guid}/currencies"
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using PersonalFinance.Contracts.Profiles
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject BffAuthenticationStateProvider Authentication

<PageTitle>Currency settings</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8 px-4">
    @if (_loading)
    {
        <div role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
            <MudText>Loading currency settings…</MudText>
        </div>
    }
    else if (_unavailable)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Currency settings unavailable</MudText>
        <MudText role="status">These settings aren't available. The profile may have been removed or you may no longer have access.</MudText>
        <MudButton Href="/budget-profiles" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Back to profiles</MudButton>
    }
    else if (_error)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Currency settings</MudText>
        <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">We couldn't load currency settings. Please try again.</MudAlert>
        <MudButton OnClick="LoadAsync" Variant="Variant.Outlined" Color="Color.Primary">Try again</MudButton>
        <MudButton Href="@($"/budget-profiles/{ProfileId}")" Class="ml-2">Back to profile</MudButton>
    }
    else if (_settings is not null)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Currency settings</MudText>
        <MudText Typo="Typo.body1">Your access: @RoleLabel(_settings.Role)</MudText>

        <MudPaper Outlined="true" Class="pa-4 mt-5">
            <MudText Typo="Typo.h6" HtmlTag="h2">Saved currencies</MudText>
            <MudText>Main currency: @_settings.MainCurrency</MudText>
            <MudText>Additional currencies: @(_settings.AdditionalCurrencies.Count == 0 ? "None" : string.Join(", ", _settings.AdditionalCurrencies))</MudText>
        </MudPaper>

        @if (_saveError is not null)
        {
            <MudAlert Severity="@(_saveUncertain ? Severity.Warning : Severity.Error)" Class="mt-4" role="alert">@_saveError</MudAlert>
            <MudButton OnClick="ReloadLatestAsync" Disabled="_saving || _loading" Variant="Variant.Outlined" Class="mt-2">Reload saved settings</MudButton>
        }
        @if (_saved)
        {
            <MudAlert Severity="Severity.Success" Class="mt-4" role="status">Currency settings saved.</MudAlert>
        }

        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" HtmlTag="h2">Configure currencies</MudText>
            <MudText>Main currency stays fixed at @_settings.MainCurrency.</MudText>
            @if (_canEdit)
            {
                <MudCheckBox T="bool" Value="_enableAlternative" ValueChanged="AlternativeChanged" Disabled="_saving"
                             Label="@($"Enable {AlternativeCurrency} as an additional currency")" />
                <MudButton OnClick="SaveAsync" Disabled="_saving" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">
                    @(_saving ? "Saving…" : "Save currency settings")
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body2">You can review these settings but cannot change them.</MudText>
            }
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" HtmlTag="h2">Supported currencies</MudText>
            <ul aria-label="Supported currencies">
                @foreach (var currency in _settings.SupportedCurrencies)
                {
                    <li @key="currency.Code">@currency.Name (@currency.Code, @currency.Symbol)</li>
                }
            </ul>
        </MudPaper>

        <MudButton Href="@($"/budget-profiles/{ProfileId}")" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-5">Back to profile</MudButton>
    }
</MudContainer>

@code {
    [Parameter] public Guid ProfileId { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _activeLoad;
    private int _loadGeneration;
    private ProfileCurrencySettingsResponse? _settings;
    private bool _loading;
    private bool _error;
    private bool _unavailable;
    private bool _enableAlternative;
    private bool _saving;
    private bool _saved;
    private bool _saveUncertain;
    private string? _saveError;
    private long _configurationVersion;
    private bool _canEdit => _settings?.Role is "owner" or "editor";
    private string AlternativeCurrency => _settings?.MainCurrency == "GBP" ? "USD" : "GBP";

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var generation = ++_loadGeneration;
        var requestCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var previousLoad = _activeLoad;
        _activeLoad = requestCancellation;
        previousLoad?.Cancel();

        _loading = true;
        _error = false;
        _unavailable = false;
        _settings = null;
        var cancellationToken = requestCancellation.Token;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, $"api/budget-profiles/{ProfileId}/currency-settings");
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            using var response = await Http.SendAsync(request, cancellationToken);
            if (generation != _loadGeneration) return;
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Authentication.NotifySignedOut();
                Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/budget-profiles/{ProfileId}/currencies")}", replace: true);
                return;
            }
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _unavailable = true;
                return;
            }
            response.EnsureSuccessStatusCode();
            var settings = await response.Content.ReadFromJsonAsync<ProfileCurrencySettingsResponse>(cancellationToken: cancellationToken)
                ?? throw new JsonException("The currency settings are missing.");
            if (generation == _loadGeneration)
            {
                _settings = settings;
                _configurationVersion = settings.ConfigurationVersion;
                _enableAlternative = settings.AdditionalCurrencies.Contains(AlternativeCurrency, StringComparer.Ordinal);
            }
        }
        catch (OperationCanceledException) when (requestCancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or JsonException)
        {
            if (generation == _loadGeneration) _error = true;
        }
        finally
        {
            if (generation == _loadGeneration) _loading = false;
            if (ReferenceEquals(_activeLoad, requestCancellation)) _activeLoad = null;
            requestCancellation.Dispose();
        }
    }

    private void AlternativeChanged(bool enabled)
    {
        _enableAlternative = enabled;
        _saved = false;
        _saveError = null;
        _saveUncertain = false;
    }

    private async Task ReloadLatestAsync()
    {
        _saveError = null;
        _saveUncertain = false;
        _saved = false;
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        if (_saving || !_canEdit || _settings is null) return;
        _saving = true;
        _saveError = null;
        _saveUncertain = false;
        _saved = false;
        var updateStarted = false;
        try
        {
            using var proofRequest = CredentialedRequest(HttpMethod.Get, "api/auth/antiforgery");
            using var proofResponse = await Http.SendAsync(proofRequest, _lifetime.Token);
            if (proofResponse.StatusCode == HttpStatusCode.Unauthorized) { ReturnToLogin(); return; }
            proofResponse.EnsureSuccessStatusCode();
            var proof = await proofResponse.Content.ReadFromJsonAsync<AntiforgeryProof>(cancellationToken: _lifetime.Token);
            if (string.IsNullOrWhiteSpace(proof?.RequestToken)) throw new JsonException("Missing request proof.");

            using var request = CredentialedRequest(HttpMethod.Put, $"api/budget-profiles/{ProfileId}/currency-settings");
            request.Headers.Add("X-CSRF-TOKEN", proof.RequestToken);
            request.Content = JsonContent.Create(new UpdateProfileCurrencySettingsRequest(
                _enableAlternative ? [AlternativeCurrency] : [], _configurationVersion));
            updateStarted = true;
            using var response = await Http.SendAsync(request, _lifetime.Token);
            if (response.StatusCode == HttpStatusCode.Unauthorized) { ReturnToLogin(); return; }
            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                _saveError = "Currency settings changed since you opened them. Reload the latest settings before saving.";
                return;
            }
            if (response.StatusCode == HttpStatusCode.NotFound) { _settings = null; _unavailable = true; return; }
            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _saveError = "You no longer have permission to change these settings. Refresh them to see your current access.";
                return;
            }
            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                _saveError = "The currency selection was rejected. Review the settings and try again.";
                return;
            }
            response.EnsureSuccessStatusCode();
            await LoadAsync();
            _saved = !_error && !_unavailable;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or JsonException)
        {
            _saveUncertain = updateStarted;
            _saveError = updateStarted
                ? "We couldn't confirm whether the settings were saved. Your draft is still here; reload the latest settings before trying again."
                : "We couldn't prepare the save request. Your draft is still here; try again.";
        }
        finally { _saving = false; }
    }

    private static HttpRequestMessage CredentialedRequest(HttpMethod method, string path)
    {
        var request = new HttpRequestMessage(method, path);
        request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
        return request;
    }

    private void ReturnToLogin()
    {
        Authentication.NotifySignedOut();
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/budget-profiles/{ProfileId}/currencies")}", replace: true);
    }

    private sealed record AntiforgeryProof(string? RequestToken);

    private static string RoleLabel(string role) => role switch
    {
        "owner" => "Owner",
        "editor" => "Editor",
        "view_only" => "View only",
        _ => "Unavailable"
    };

    public void Dispose()
    {
        _activeLoad?.Cancel();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
