@page "/budget-profiles/{ProfileId:guid}/currencies"
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using PersonalFinance.Contracts.Profiles
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject BffAuthenticationStateProvider Authentication

@* Comment ID: CLASS-046. Shows the current profile's saved currencies and supported choices to authorized participants. *@
<PageTitle>Currency settings</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8 px-4">
    @if (_loading)
    {
        <div role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
            <MudText>Loading currency settings…</MudText>
        </div>
    }
    else if (_unavailable)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Currency settings unavailable</MudText>
        <MudText role="status">These settings aren't available. The profile may have been removed or you may no longer have access.</MudText>
        <MudButton Href="/budget-profiles" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Back to profiles</MudButton>
    }
    else if (_error)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Currency settings</MudText>
        <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">We couldn't load currency settings. Please try again.</MudAlert>
        <MudButton OnClick="LoadAsync" Variant="Variant.Outlined" Color="Color.Primary">Try again</MudButton>
        <MudButton Href="@($"/budget-profiles/{ProfileId}")" Class="ml-2">Back to profile</MudButton>
    }
    else if (_settings is not null)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Currency settings</MudText>
        <MudText Typo="Typo.body1">Your access: @RoleLabel(_settings.Role)</MudText>

        <MudPaper Outlined="true" Class="pa-4 mt-5">
            <MudText Typo="Typo.h6" HtmlTag="h2">Saved currencies</MudText>
            <MudText>Main currency: @_settings.MainCurrency</MudText>
            <MudText>Additional currencies: @(_settings.AdditionalCurrencies.Count == 0 ? "None" : string.Join(", ", _settings.AdditionalCurrencies))</MudText>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" HtmlTag="h2">Supported currencies</MudText>
            <ul aria-label="Supported currencies">
                @foreach (var currency in _settings.SupportedCurrencies)
                {
                    <li @key="currency.Code">@currency.Name (@currency.Code, @currency.Symbol)</li>
                }
            </ul>
        </MudPaper>

        <MudButton Href="@($"/budget-profiles/{ProfileId}")" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-5">Back to profile</MudButton>
    }
</MudContainer>

@code {
    [Parameter] public Guid ProfileId { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _activeLoad;
    private int _loadGeneration;
    private ProfileCurrencySettingsResponse? _settings;
    private bool _loading;
    private bool _error;
    private bool _unavailable;

    // Comment ID: METHOD-063. Reloads settings when this route receives a profile identifier.
    protected override Task OnParametersSetAsync() => LoadAsync();

    // Comment ID: METHOD-064. Loads current settings with the BFF session and presents access, network, and server failures explicitly.
    private async Task LoadAsync()
    {
        var generation = ++_loadGeneration;
        var requestCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var previousLoad = _activeLoad;
        _activeLoad = requestCancellation;
        previousLoad?.Cancel();

        _loading = true;
        _error = false;
        _unavailable = false;
        _settings = null;
        var cancellationToken = requestCancellation.Token;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, $"api/budget-profiles/{ProfileId}/currency-settings");
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            using var response = await Http.SendAsync(request, cancellationToken);
            if (generation != _loadGeneration) return;
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Authentication.NotifySignedOut();
                Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/budget-profiles/{ProfileId}/currencies")}", replace: true);
                return;
            }
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _unavailable = true;
                return;
            }
            response.EnsureSuccessStatusCode();
            var settings = await response.Content.ReadFromJsonAsync<ProfileCurrencySettingsResponse>(cancellationToken: cancellationToken)
                ?? throw new JsonException("The currency settings are missing.");
            if (generation == _loadGeneration) _settings = settings;
        }
        catch (OperationCanceledException) when (requestCancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or JsonException)
        {
            if (generation == _loadGeneration) _error = true;
        }
        finally
        {
            if (generation == _loadGeneration) _loading = false;
            if (ReferenceEquals(_activeLoad, requestCancellation)) _activeLoad = null;
            requestCancellation.Dispose();
        }
    }

    // Comment ID: METHOD-065. Converts the server role code into a user-facing access label.
    private static string RoleLabel(string role) => role switch
    {
        "owner" => "Owner",
        "editor" => "Editor",
        "view_only" => "View only",
        _ => "Unavailable"
    };

    // Comment ID: METHOD-066. Cancels outstanding settings reads when the view is removed.
    public void Dispose()
    {
        _activeLoad?.Cancel();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
