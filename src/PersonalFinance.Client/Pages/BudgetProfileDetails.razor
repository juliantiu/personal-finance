@* Comment ID: CLASS-047. Shows accessible profile details and an owner-only participant list. *@
@page "/budget-profiles/{ProfileId:guid}"
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using PersonalFinance.Contracts.Profiles
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject BffAuthenticationStateProvider Authentication

<PageTitle>@(_profile?.Name ?? "Budget profile")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8 px-4">
    @if (_loading)
    {
        <div role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
            <MudText>Loading budget profile…</MudText>
        </div>
    }
    else if (_unavailable)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Budget profile unavailable</MudText>
        <MudText role="status">This profile isn't available. It may have been removed or you may no longer have access.</MudText>
        <MudButton Href="/budget-profiles" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Back to profiles</MudButton>
    }
    else if (_error)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Budget profile</MudText>
        <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">We couldn't load this budget profile. Please try again.</MudAlert>
        <MudButton OnClick="LoadAsync" Variant="Variant.Outlined" Color="Color.Primary">Try again</MudButton>
        <MudButton Href="/budget-profiles" Class="ml-2">Back to profiles</MudButton>
    }
    else if (_profile is not null)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@_profile.Name</MudText>
        <MudText Typo="Typo.body1">Your access: @RoleLabel(_profile.Role)</MudText>
        @if (_profile.Role == "owner")
        {
            <MudPaper Outlined="true" Class="pa-4 mt-4">
                <MudText Typo="Typo.h6" HtmlTag="h2">Sharing</MudText>
                <MudStack Spacing="2" Class="mt-3 mb-4">
                    <MudTextField Label="Account email" InputType="InputType.Email" @bind-Value="_shareEmail" />
                    <MudSelect T="string" Label="Access role" @bind-Value="_shareRole">
                        <MudSelectItem T="string" Value="@("editor")">Editor</MudSelectItem>
                        <MudSelectItem T="string" Value="@("view_only")">View only</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_shareSaving || string.IsNullOrWhiteSpace(_shareEmail)" OnClick="GrantParticipantAsync">
                        @(_shareSaving ? "Saving…" : "Save access")
                    </MudButton>
                    @if (_shareSuccess) { <MudText Color="Color.Success" role="status">@_shareSuccessMessage</MudText> }
                    @if (_shareError is not null) { <MudAlert Severity="Severity.Error" role="alert">@_shareError</MudAlert> }
                </MudStack>
                @if (_participantsLoading) { <MudText role="status">Loading participants…</MudText> }
                else if (_participantsError) { <MudAlert Severity="Severity.Error" role="alert">We couldn't load profile participants.</MudAlert><MudButton OnClick="RetryLoadParticipantsAsync">Try again</MudButton> }
                else if (_participants is { Length: 0 }) { <MudText>No participants have access yet.</MudText> }
                else if (_participants is not null)
                {
                    <ul aria-label="Profile participants">
                        @foreach (var participant in _participants)
                        {
                            <li @key="participant.Email">
                                @participant.Email — @RoleLabel(participant.Role)
                                <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="_shareSaving"
                                           aria-label="@($"Remove access for {participant.Email}")"
                                           OnClick="@(() => RemoveParticipantAsync(participant.Email))">Remove access</MudButton>
                            </li>
                        }
                    </ul>
                }
            </MudPaper>
        }

        <MudPaper Outlined="true" Class="pa-4 mt-5">
            <MudText Typo="Typo.h6" HtmlTag="h2">Profile settings</MudText>
            <MudText>Main currency: @_profile.MainCurrency</MudText>
            <MudText>Additional currencies: @( _profile.AdditionalCurrencies.Count == 0 ? "None" : string.Join(", ", _profile.AdditionalCurrencies))</MudText>
            <MudButton Href="@($"/budget-profiles/{ProfileId}/currencies")" Variant="Variant.Text" Color="Color.Primary" Class="mt-2">Review currency choices</MudButton>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" HtmlTag="h2">Categories</MudText>
            <ul aria-label="Profile categories">
                @foreach (var category in _profile.Categories)
                {
                    <li @key="category.Id">@category.Name</li>
                }
            </ul>
            <MudButton Href="@($"/budget-profiles/{ProfileId}/categories")" Variant="Variant.Text" Color="Color.Primary" Class="mt-2">Review categories</MudButton>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" HtmlTag="h2">Payment methods</MudText>
            <ul aria-label="Profile payment methods">
                @foreach (var method in _profile.PaymentMethods)
                {
                    <li @key="method.Kind">@PaymentMethodLabel(method.Kind)</li>
                }
            </ul>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" HtmlTag="h2">Tags</MudText>
            <ul aria-label="Profile tags">
                @foreach (var tag in _profile.Tags)
                {
                    <li @key="tag.Role">@tag.Name</li>
                }
            </ul>
        </MudPaper>

        <MudButton Href="/budget-profiles" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-5">Back to profiles</MudButton>
    }
</MudContainer>

@code {
    [Parameter] public Guid ProfileId { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _activeLoad;
    private int _loadGeneration;
    private ProfileDetailsResponse? _profile;
    private bool _loading;
    private bool _error;
    private bool _unavailable;
    private bool _participantsLoading;
    private bool _participantsError;
    private ProfileParticipantResponse[]? _participants;
    private string _shareEmail = string.Empty;
    private string _shareRole = "editor";
    private bool _shareSaving;
    private bool _shareSuccess;
    private string _shareSuccessMessage = "Access saved.";
    private string? _shareError;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var generation = ++_loadGeneration;
        var requestCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var previousLoad = _activeLoad;
        _activeLoad = requestCancellation;
        previousLoad?.Cancel();

        _loading = true;
        _error = false;
        _unavailable = false;
        _profile = null;
        _participants = null;
        _participantsLoading = false;
        _participantsError = false;
        var cancellationToken = requestCancellation.Token;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, $"api/budget-profiles/{ProfileId}");
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            using var response = await Http.SendAsync(request, cancellationToken);
            if (generation != _loadGeneration) return;
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Authentication.NotifySignedOut();
                Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/budget-profiles/{ProfileId}")}", replace: true);
                return;
            }
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _unavailable = true;
                return;
            }
            response.EnsureSuccessStatusCode();
            var profile = await response.Content.ReadFromJsonAsync<ProfileDetailsResponse>(cancellationToken: cancellationToken)
                ?? throw new JsonException("The profile details are missing.");
            if (generation == _loadGeneration)
            {
                _profile = profile;
                if (profile.Role == "owner")
                {
                    _loading = false;
                    _participantsLoading = true;
                    await InvokeAsync(StateHasChanged);
                    await LoadParticipantsAsync(ProfileId, generation, cancellationToken);
                }
            }
        }
        catch (OperationCanceledException) when (requestCancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or JsonException)
        {
            if (generation == _loadGeneration) _error = true;
        }
        finally
        {
            if (generation == _loadGeneration) _loading = false;
            if (ReferenceEquals(_activeLoad, requestCancellation)) _activeLoad = null;
            requestCancellation.Dispose();
        }
    }

    private async Task LoadParticipantsAsync(Guid profileId, int generation, CancellationToken cancellationToken)
    {
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, $"api/budget-profiles/{profileId}/participants");
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            using var response = await Http.SendAsync(request, cancellationToken);
            response.EnsureSuccessStatusCode();
            var participants = await response.Content.ReadFromJsonAsync<ProfileParticipantResponse[]>(cancellationToken: cancellationToken) ?? [];
            if (generation == _loadGeneration) _participants = participants;
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or JsonException)
        {
            if (generation == _loadGeneration) _participantsError = true;
        }
        finally
        {
            if (generation == _loadGeneration) _participantsLoading = false;
        }
    }

    private async Task RetryLoadParticipantsAsync()
    {
        _participantsLoading = true;
        _participantsError = false;
        await LoadParticipantsAsync(ProfileId, _loadGeneration, _activeLoad?.Token ?? _lifetime.Token);
    }

    private async Task GrantParticipantAsync()
    {
        _shareSaving = true;
        _shareSuccess = false;
        _shareSuccessMessage = "Access saved.";
        _shareError = null;
        try
        {
            var token = await GetAntiforgeryTokenAsync();
            if (token is null) return;
            using var request = new HttpRequestMessage(HttpMethod.Post, $"api/budget-profiles/{ProfileId}/participants")
            {
                Content = JsonContent.Create(new ProfileAccessGrantRequest(_shareEmail, _shareRole))
            };
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            request.Headers.Add("X-CSRF-TOKEN", token);
            using var response = await Http.SendAsync(request, _lifetime.Token);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Authentication.NotifySignedOut();
                Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/budget-profiles/{ProfileId}")}", replace: true);
                return;
            }
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _shareError = "No eligible account found.";
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                _shareError = await ReadSharingErrorAsync(response, "We couldn't save profile access. Please try again.");
                return;
            }

            _shareSuccess = true;
            _shareEmail = string.Empty;
            _participantsLoading = true;
            await LoadParticipantsAsync(ProfileId, _loadGeneration, _lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or JsonException)
        {
            _shareError = "We couldn't save profile access. Please try again.";
        }
        finally
        {
            _shareSaving = false;
        }
    }

    private async Task RemoveParticipantAsync(string email)
    {
        _shareSaving = true;
        _shareSuccess = false;
        _shareError = null;
        try
        {
            var token = await GetAntiforgeryTokenAsync();
            if (token is null) return;
            using var request = new HttpRequestMessage(HttpMethod.Delete, $"api/budget-profiles/{ProfileId}/participants")
            {
                Content = JsonContent.Create(new ProfileAccessRemovalRequest(email))
            };
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            request.Headers.Add("X-CSRF-TOKEN", token);
            using var response = await Http.SendAsync(request, _lifetime.Token);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Authentication.NotifySignedOut();
                Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/budget-profiles/{ProfileId}")}", replace: true);
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                _shareError = await ReadSharingErrorAsync(response,
                    "We couldn't remove profile access. Please try again.");
                return;
            }

            _shareSuccess = true;
            _shareSuccessMessage = "Access removed.";
            _participantsLoading = true;
            await LoadParticipantsAsync(ProfileId, _loadGeneration, _lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or JsonException)
        {
            _shareError = "We couldn't remove profile access. Please try again.";
        }
        finally
        {
            _shareSaving = false;
        }
    }

    private static async Task<string> ReadSharingErrorAsync(HttpResponseMessage response, string fallbackMessage)
    {
        try
        {
            using var document = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            if (document.RootElement.TryGetProperty("title", out var title) && title.ValueKind == JsonValueKind.String
                && !string.IsNullOrWhiteSpace(title.GetString()))
                return title.GetString()!;
        }
        catch (JsonException) { }
        return fallbackMessage;
    }

    // Comment ID: METHOD-065. Fetches a fresh request token for the cookie-authenticated sharing mutation.
    private async Task<string?> GetAntiforgeryTokenAsync()
    {
        using var request = new HttpRequestMessage(HttpMethod.Get, "api/auth/antiforgery");
        request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
        using var response = await Http.SendAsync(request, _lifetime.Token);
        if (response.StatusCode == HttpStatusCode.Unauthorized)
        {
            Authentication.NotifySignedOut();
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/budget-profiles/{ProfileId}")}", replace: true);
            return null;
        }
        response.EnsureSuccessStatusCode();
        var proof = await response.Content.ReadFromJsonAsync<AntiforgeryProof>(cancellationToken: _lifetime.Token);
        return string.IsNullOrWhiteSpace(proof?.RequestToken)
            ? throw new JsonException("Missing request proof.")
            : proof.RequestToken;
    }

    private static string RoleLabel(string role) => role switch
    {
        "owner" => "Owner",
        "editor" => "Editor",
        "view_only" => "View only",
        _ => "Unavailable"
    };

    private static string PaymentMethodLabel(string kind) => kind switch
    {
        "cash" => "Cash",
        _ => "Unavailable"
    };

    public void Dispose()
    {
        _activeLoad?.Cancel();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    // Comment ID: CLASS-055. Carries the antiforgery request token returned for a cookie-authenticated mutation.
    private sealed record AntiforgeryProof(string? RequestToken);
}
