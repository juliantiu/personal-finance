@page "/budget-profiles/{ProfileId:guid}/categories"
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using PersonalFinance.Contracts.Profiles
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject BffAuthenticationStateProvider Authentication

<PageTitle>Categories</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8 px-4">
    @if (_loading)
    {
        <div role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
            <MudText>Loading categories…</MudText>
        </div>
    }
    else if (_unavailable)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Categories unavailable</MudText>
        <MudText role="status">These categories aren't available. The profile may have been removed or you may no longer have access.</MudText>
        <MudButton Href="/budget-profiles" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Back to profiles</MudButton>
    }
    else if (_error)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Categories</MudText>
        <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">We couldn't load categories. Please try again.</MudAlert>
        <MudButton OnClick="LoadAsync" Variant="Variant.Outlined" Color="Color.Primary">Try again</MudButton>
        <MudButton Href="@($"/budget-profiles/{ProfileId}")" Class="ml-2">Back to profile</MudButton>
    }
    else if (_categories is not null)
    {
        <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Categories</MudText>
        <MudText Typo="Typo.body1">Your access: @RoleLabel(_categories.Role)</MudText>

        <MudPaper Outlined="true" Class="pa-4 mt-5">
            <MudText Typo="Typo.h6" HtmlTag="h2">Profile categories</MudText>
            @if (IsWriter)
            {
                <MudPaper Outlined="true" Class="pa-4 my-4">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h3">Add category</MudText>
                    <MudTextField T="string" Label="Category name" Value="_newCategoryName" ValueChanged="NewCategoryNameChanged"
                                  MaxLength="100" Disabled="_creating || _createUncertain" />
                    <MudTextField T="string" Label="Comment (optional)" Value="_newCategoryComment" ValueChanged="NewCategoryCommentChanged"
                                  Lines="3" MaxLength="2000" Disabled="_creating || _createUncertain" />
                    <MudButton OnClick="CreateCategoryAsync" Disabled="_creating || _createUncertain" Variant="Variant.Filled" Color="Color.Primary">
                        @(_creating ? "Creating…" : "Add category")
                    </MudButton>
                    @if (_createUncertain)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-3" role="alert">
                            We couldn't confirm whether this category was created. Review the saved categories before choosing to retry.
                        </MudAlert>
                        <MudButton OnClick="ReviewAfterUncertainCreateAsync" Disabled="_creating" Variant="Variant.Outlined">Review categories</MudButton>
                    }
                </MudPaper>
            }
            @if (_formError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" role="alert">@_formError</MudAlert>
            }
            @if (_categories.Categories.Count == 0)
            {
                <MudText role="status">No categories are available for this profile.</MudText>
            }
            else
            {
                <ul aria-label="Profile categories">
                    @foreach (var category in _categories.Categories)
                    {
                        <li @key="category.Id" class="mb-3">
                            @if (IsWriter)
                            {
                                <MudText Typo="Typo.subtitle1">@KindLabel(category.Kind) category</MudText>
                                <MudTextField T="string" Label="Category name" Value="GetDraftName(category)"
                                              ValueChanged="value => SetDraftName(category.Id, value)" MaxLength="100" Disabled="_savingCategoryId == category.Id" />
                                <MudTextField T="string" Label="Comment (optional)" Value="GetDraftComment(category)"
                                              ValueChanged="value => SetDraftComment(category.Id, value)" Lines="3" MaxLength="2000" Disabled="_savingCategoryId == category.Id" />
                                <MudButton OnClick="() => SaveCategoryAsync(category)" Disabled="_savingCategoryId == category.Id"
                                           Variant="Variant.Outlined" Color="Color.Primary">
                                    @(_savingCategoryId == category.Id ? "Saving…" : "Save category")
                                </MudButton>
                                @if (_conflictCategoryId == category.Id)
                                {
                                    <MudAlert Severity="Severity.Warning" Class="mt-2" role="alert">
                                        This category changed since you opened it. Your draft is still available. Load the latest version, review your draft, then save again.
                                    </MudAlert>
                                    <MudButton OnClick="() => ReloadAfterConflictAsync(category.Id)" Variant="Variant.Outlined">Load latest category</MudButton>
                                }
                            }
                            else
                            {
                                <MudText>@category.Name</MudText>
                                @if (!string.IsNullOrWhiteSpace(category.Comment))
                                {
                                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap">Comment: @category.Comment</MudText>
                                }
                            }
                            @if (category.Kind == "ordinary")
                            {
                                <MudText Typo="Typo.body2">Category type: Ordinary</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">System category: @KindLabel(category.Kind)</MudText>
                            }
                        </li>
                    }
                </ul>
            }
        </MudPaper>
        <MudButton Href="@($"/budget-profiles/{ProfileId}")" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-5">Back to profile</MudButton>
    }
</MudContainer>

@code {
    [Parameter] public Guid ProfileId { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _activeLoad;
    private int _loadGeneration;
    private ProfileCategoriesResponse? _categories;
    private readonly Dictionary<Guid, string> _draftNames = [];
    private readonly Dictionary<Guid, string?> _draftComments = [];
    private bool _loading;
    private bool _error;
    private bool _unavailable;
    private bool _creating;
    private bool _createUncertain;
    private Guid? _savingCategoryId;
    private Guid? _conflictCategoryId;
    private string _newCategoryName = string.Empty;
    private string? _newCategoryComment;
    private string? _formError;
    private bool IsWriter => _categories?.Role is "owner" or "editor";

    protected override Task OnParametersSetAsync() => LoadAsync();

    private Task LoadAsync() => LoadCategoriesAsync(preserveDrafts: false);

    private async Task LoadCategoriesAsync(bool preserveDrafts)
    {
        var generation = ++_loadGeneration;
        var profileId = ProfileId;
        var requestCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        var previousLoad = _activeLoad;
        _activeLoad = requestCancellation;
        previousLoad?.Cancel();

        _loading = true;
        _error = false;
        _unavailable = false;
        _categories = null;
        _formError = null;
        if (!preserveDrafts)
        {
            _draftNames.Clear();
            _draftComments.Clear();
            _conflictCategoryId = null;
        }
        var cancellationToken = requestCancellation.Token;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, $"api/budget-profiles/{profileId}/categories");
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            using var response = await Http.SendAsync(request, cancellationToken);
            if (generation != _loadGeneration) return;
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Authentication.NotifySignedOut();
                Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/budget-profiles/{profileId}/categories")}", replace: true);
                return;
            }
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _unavailable = true;
                return;
            }
            response.EnsureSuccessStatusCode();
            var categories = await response.Content.ReadFromJsonAsync<ProfileCategoriesResponse>(cancellationToken: cancellationToken)
                ?? throw new JsonException("The categories are missing.");
            if (generation == _loadGeneration)
            {
                _categories = categories;
                foreach (var category in categories.Categories)
                {
                    _draftNames.TryAdd(category.Id, category.Name);
                    _draftComments.TryAdd(category.Id, category.Comment);
                }
            }
        }
        catch (OperationCanceledException) when (requestCancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or JsonException)
        {
            if (generation == _loadGeneration) _error = true;
        }
        finally
        {
            if (generation == _loadGeneration) _loading = false;
            if (ReferenceEquals(_activeLoad, requestCancellation)) _activeLoad = null;
            requestCancellation.Dispose();
        }
    }

    private async Task CreateCategoryAsync()
    {
        if (_creating || _createUncertain || !IsWriter) return;
        _formError = null;
        if (string.IsNullOrWhiteSpace(_newCategoryName)) { _formError = "Enter a category name."; return; }
        if (_newCategoryName.Trim().Length > 100) { _formError = "Use at most 100 characters after trimming."; return; }
        if (_newCategoryComment?.Length > 2000) { _formError = "Use at most 2,000 characters for a comment."; return; }

        _creating = true;
        var requestStarted = false;
        try
        {
            var token = await GetAntiforgeryTokenAsync();
            using var request = CredentialedRequest(HttpMethod.Post, $"api/budget-profiles/{ProfileId}/categories");
            request.Headers.Add("X-CSRF-TOKEN", token);
            request.Content = JsonContent.Create(new CreateProfileCategoryRequest(_newCategoryName, _newCategoryComment));
            requestStarted = true;
            using var response = await Http.SendAsync(request, _lifetime.Token);
            if (response.StatusCode == HttpStatusCode.Unauthorized) { ReturnToLogin(); return; }
            if (response.StatusCode == HttpStatusCode.NotFound) { SetUnavailable(); return; }
            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                _formError = "The category wasn't created. Check the name and comment, then try again.";
                return;
            }
            if (response.StatusCode != HttpStatusCode.Created) { _createUncertain = true; return; }
            _newCategoryName = string.Empty;
            _newCategoryComment = null;
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or JsonException)
        {
            if (requestStarted) _createUncertain = true;
            else _formError = "We couldn't prepare the request. The category wasn't submitted. Try again.";
        }
        finally { _creating = false; }
    }

    private async Task SaveCategoryAsync(ProfileCategoryResponse category)
    {
        if (_savingCategoryId is not null || !IsWriter) return;
        _formError = null;
        var name = GetDraftName(category);
        var comment = GetDraftComment(category);
        if (string.IsNullOrWhiteSpace(name)) { _formError = "Enter a category name."; return; }
        if (name.Trim().Length > 100) { _formError = "Use at most 100 characters after trimming."; return; }
        if (comment?.Length > 2000) { _formError = "Use at most 2,000 characters for a comment."; return; }

        _savingCategoryId = category.Id;
        try
        {
            var token = await GetAntiforgeryTokenAsync();
            using var request = CredentialedRequest(HttpMethod.Put, $"api/budget-profiles/{ProfileId}/categories/{category.Id}");
            request.Headers.Add("X-CSRF-TOKEN", token);
            request.Content = JsonContent.Create(new UpdateProfileCategoryRequest(name, comment, category.Version));
            using var response = await Http.SendAsync(request, _lifetime.Token);
            if (response.StatusCode == HttpStatusCode.Unauthorized) { ReturnToLogin(); return; }
            if (response.StatusCode == HttpStatusCode.NotFound) { SetUnavailable(); return; }
            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                _conflictCategoryId = category.Id;
                return;
            }
            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                _formError = "The category wasn't saved. Check the name and comment, then try again.";
                return;
            }
            response.EnsureSuccessStatusCode();
            _conflictCategoryId = null;
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or JsonException)
        {
            _formError = "We couldn't confirm that the category was saved. Review the latest category before trying again.";
        }
        finally { _savingCategoryId = null; }
    }

    private async Task ReloadAfterConflictAsync(Guid categoryId)
    {
        await LoadCategoriesAsync(preserveDrafts: true);
        if (_categories?.Categories.Any(category => category.Id == categoryId) != true) SetUnavailable();
    }

    private async Task ReviewAfterUncertainCreateAsync()
    {
        await LoadAsync();
        if (_categories is not null) _createUncertain = false;
    }

    private async Task<string> GetAntiforgeryTokenAsync()
    {
        using var request = CredentialedRequest(HttpMethod.Get, "api/auth/antiforgery");
        using var response = await Http.SendAsync(request, _lifetime.Token);
        if (response.StatusCode == HttpStatusCode.Unauthorized) { ReturnToLogin(); throw new OperationCanceledException(_lifetime.Token); }
        response.EnsureSuccessStatusCode();
        var proof = await response.Content.ReadFromJsonAsync<AntiforgeryProof>(cancellationToken: _lifetime.Token);
        return string.IsNullOrWhiteSpace(proof?.RequestToken) ? throw new JsonException("Missing request proof.") : proof.RequestToken;
    }

    private string GetDraftName(ProfileCategoryResponse category) => _draftNames.GetValueOrDefault(category.Id, category.Name);

    private string? GetDraftComment(ProfileCategoryResponse category) => _draftComments.GetValueOrDefault(category.Id, category.Comment);

    private void SetDraftName(Guid categoryId, string value) => _draftNames[categoryId] = value;

    private void SetDraftComment(Guid categoryId, string? value) => _draftComments[categoryId] = value;

    private void NewCategoryNameChanged(string value) => _newCategoryName = value;

    private void NewCategoryCommentChanged(string? value) => _newCategoryComment = value;

    private static HttpRequestMessage CredentialedRequest(HttpMethod method, string path)
    {
        var request = new HttpRequestMessage(method, path);
        request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
        return request;
    }

    private void SetUnavailable()
    {
        _categories = null;
        _unavailable = true;
        _loading = false;
    }

    private void ReturnToLogin()
    {
        Authentication.NotifySignedOut();
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/budget-profiles/{ProfileId}/categories")}", replace: true);
    }

    private static string RoleLabel(string role) => role switch
    {
        "owner" => "Owner",
        "editor" => "Editor",
        "view_only" => "View only",
        _ => "Unavailable"
    };

    private static string KindLabel(string kind) => kind switch
    {
        "income" => "Income",
        "savings" => "Savings",
        "debt" => "Debt",
        "ordinary" => "Ordinary",
        _ => "Unavailable"
    };

    public void Dispose()
    {
        _activeLoad?.Cancel();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed record AntiforgeryProof(string? RequestToken);
}
