@* Comment ID: CLASS-032. Ends the current browser session and exposes safe retry feedback on failure. *@
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@inject HttpClient Http
@inject BffAuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<div class="pa-4">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_submitting" OnClick="SignOutAsync">
        @(_submitting ? "Signing out…" : "Sign out")
    </MudButton>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
    }
</div>

@code {
    private bool _submitting;
    private string? _error;

    // Comment ID: METHOD-050. Obtains fresh antiforgery proof, posts sign-out with cookies, and updates state only after success.
    private async Task SignOutAsync()
    {
        if (_submitting) return;
        _submitting = true;
        _error = null;
        try
        {
            using var tokenRequest = new HttpRequestMessage(HttpMethod.Get, "api/auth/antiforgery");
            tokenRequest.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            using var tokenResponse = await Http.SendAsync(tokenRequest);
            tokenResponse.EnsureSuccessStatusCode();
            var token = await tokenResponse.Content.ReadFromJsonAsync<AntiforgeryToken>();
            if (string.IsNullOrWhiteSpace(token?.RequestToken))
            {
                _error = "We couldn’t complete sign-out. Please try again.";
                return;
            }
            using var request = new HttpRequestMessage(HttpMethod.Post, "api/auth/sign-out");
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
            request.Headers.Add("X-CSRF-TOKEN", token.RequestToken);
            using var response = await Http.SendAsync(request);
            response.EnsureSuccessStatusCode();
            Authentication.NotifySignedOut();
            Navigation.NavigateTo("/login?signedOut=true");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = "We couldn’t complete sign-out. Check your connection and try again.";
        }
        finally { _submitting = false; }
    }

    // Comment ID: CLASS-033. Carries the request proof needed for the cookie-authenticated sign-out POST.
    private sealed record AntiforgeryToken(string? RequestToken);
}
